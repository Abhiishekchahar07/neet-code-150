class Solution:
    def longestConsecutive(self, nums: List[int]) -> int:

        f = sorted(set(nums))

        if len(f) == 0:
            return 0

        d = f[0]
        e = d
        count = 0
        maxi = 0

        for i in range(len(f)):

            if f[i] == e:
                count += 1
            else:
                count = 1

            maxi = max(maxi, count)
            e = f[i] + 1

        return maxi
